# Application Settings
PROJECT_NAME="AI Career Mentor API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Settings
# For MySQL: mysql+pymysql://username:password@localhost:3306/ai_career_mentor
# For SQLite (default development fallback): sqlite:///./career_mentor.db
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/ai_career_mentor"

# Security & JWT Authentication
SECRET_KEY="supersecretjwtkey_change_in_production_environment_32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"

# CORS Setup
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
